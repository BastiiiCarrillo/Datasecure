# =============================================================================
# DataSecure SpA - Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# Este archivo sí se sube a GitHub como modelo. NO contiene contraseñas reales.

# Tipo de Base de Datos: 'sqlite' (Local Windows) o 'mariadb' (Servidor AlmaLinux / Red Hat)
DB_TYPE=sqlite

# Configuración para SQLite (Plan A - Local)
DB_FILE=database/datasecure.db

# Configuración para MariaDB en Máquina Virtual AlmaLinux (Plan B - Servidor)
DB_HOST=192.168.1.100
DB_PORT=3306
DB_USER=datasecure_user
DB_PASSWORD=clave_ficticia_ejemplo
DB_NAME=datasecure_db

# Parámetros Criptográficos (Capa 4: Gestión de Claves)
LAB_SECRET_KEY=ClaveLaboratorioEjemplo2026
AES_MASTER_KEY=ClaveMaestraAES256Ejemplo!
